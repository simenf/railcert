{
  "name": "railcert-ask",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var REQUIRE_ACCESS:0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config test/vitest.config.ts && node --test test/ui-md.test.mjs",
    "cf-typegen": "wrangler types --env-interface Env src/worker-configuration.d.ts",
    "vendor": "node -e \"const fs=require('fs');fs.mkdirSync('public/vendor',{recursive:true});fs.copyFileSync('node_modules/mermaid/dist/mermaid.min.js','public/vendor/mermaid.min.js');fs.copyFileSync('node_modules/mermaid/LICENSE','public/vendor/mermaid.LICENSE.txt')\""
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@cloudflare/workers-types": "^5.20261123.1",
    "mermaid": "^12.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.167.0"
  }
}
